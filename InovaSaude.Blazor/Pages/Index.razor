@page "/"

<PageTitle>Caelum Saúde - Sistema de Gestão para UBS</PageTitle>

<!-- Hero Section -->
<div class="hero-caelum text-white py-5">
    <div class="container">
        <div class="row align-items-center">
   <div class="col-lg-6">
         <h1 class="display-4 fw-bold mb-3">🏥 Caelum Saúde</h1>
           <p class="lead mb-4">
    Plataforma da Caelum Systems para gestão financeira e operacional de Unidades Básicas de Saúde
         </p>
   <AuthorizeView>
      <Authorized>
  <a href="/dashboard" class="btn btn-light btn-lg me-2">
     <span class="oi oi-dashboard me-2"></span>Acessar Dashboard
   </a>
      </Authorized>
    <NotAuthorized>
       <a href="/login" class="btn btn-light btn-lg me-2">
      <span class="oi oi-account-login me-2"></span>Fazer Login
      </a>
       <a href="/sobre" class="btn btn-outline-light btn-lg">
  <span class="oi oi-info me-2"></span>Saiba Mais
     </a>
   </NotAuthorized>
      </AuthorizeView>
        </div>
   <div class="col-lg-6 text-center">
     <div class="p-4">
        <span style="font-size: 10rem;">💊</span>
   </div>
     </div>
   </div>
    </div>
</div>

<!-- Features Section -->
<div class="container py-5 caelum-section">
    <div class="text-center mb-5">
  <h2 class="fw-bold mb-3">Soluções da Caelum Saúde</h2>
