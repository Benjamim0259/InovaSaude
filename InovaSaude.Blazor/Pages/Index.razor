    <h5 class="card-title fw-bold">Gestão Financeira</h5>
      <p class="card-text text-muted">
  Controle completo de despesas, categorias e orçamentos por UBS
    </p>
       </div>
 </div>
 </div>

   <!-- Feature 2 -->
  <div class="col-md-4">
    <div class="card h-100 border-0 shadow-sm">
  <div class="card-body text-center p-4">
  <div class="mb-3">
      <span class="text-success" style="font-size: 3rem;">📊</span>
        </div>
  <h5 class="card-title fw-bold">Relatórios Inteligentes</h5>
      <p class="card-text text-muted">
   Dashboards e relatórios em tempo real para tomada de decisão
       </p>
     </div>
    </div>
   </div>

   <!-- Feature 3 -->
  <div class="col-md-4">
   <div class="card h-100 border-0 shadow-sm">
    <div class="card-body text-center p-4">
      <div class="mb-3">
       <span class="text-warning" style="font-size: 3rem;">🔌</span>
    </div>
