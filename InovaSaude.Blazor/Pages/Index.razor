    <h2 class="display-4 fw-bold text-warning">99.9%</h2>
            <p class="text-muted">Disponibilidade</p>
   </div>
  </div>
    </div>
</div>

<!-- CTA Section -->
<div class="container py-5 text-center caelum-cta">
    <h2 class="fw-bold mb-3">Pronto para evoluir com a Caelum Saúde?</h2>
    <p class="text-muted mb-4 lead">
      Leve sua gestão de saúde para um novo padrão de controle e inteligência
  </p>
    <AuthorizeView>
     <Authorized>
<a href="/dashboard" class="btn btn-primary btn-lg">
      <span class="oi oi-dashboard me-2"></span>Ir para Dashboard
      </a>
 </Authorized>
 <NotAuthorized>
       <a href="/login" class="btn btn-primary btn-lg me-2">
    <span class="oi oi-account-login me-2"></span>Fazer Login
       </a>
   <a href="/contato" class="btn btn-outline-primary btn-lg">
        <span class="oi oi-envelope-closed me-2"></span>Entrar em Contato
       </a>
 </NotAuthorized>
    </AuthorizeView>
</div>

<!-- Footer -->
<footer class="caelum-footer text-white py-4">
 <div class="container text-center">
   <p class="mb-0">&copy; 2025 Caelum Saúde. Todos os direitos reservados.</p>
   <p class="small text-muted mb-0">Sistema de Gestão para Unidades Básicas de Saúde</p>
