 <p class="card-text text-muted">
  Conecte com HORUS, e-SUS PEC e NEMESIS automaticamente
        </p>
        </div>
   </div>
   </div>

        <!-- Feature 4 -->
        <div class="col-md-4">
   <div class="card h-100 border-0 shadow-sm">
         <div class="card-body text-center p-4">
     <div class="mb-3">
        <span class="text-danger" style="font-size: 3rem;">👥</span>
     </div>
     <h5 class="card-title fw-bold">Multiusuário</h5>
 <p class="card-text text-muted">
   Perfis de acesso para admin, coordenador, gestor e auditor
  </p>
      </div>
      </div>
   </div>

      <!-- Feature 6 -->
    <div class="col-md-4">
        <div class="card h-100 border-0 shadow-sm">
    <div class="card-body text-center p-4">
          <div class="mb-3">
         <span class="text-secondary" style="font-size: 3rem;">🔒</span>
        </div>
          <h5 class="card-title fw-bold">Segurança</h5>
           <p class="card-text text-muted">
    Auditoria completa, logs de acesso e conformidade com LGPD
         </p>
        </div>
       </div>
      </div>

     <!-- Feature 5 -->
          <div class="col-md-4">
     <div class="card h-100 border-0 shadow-sm">
           <div class="card-body text-center p-4">
       <div class="mb-3">
          <span class="text-info" style="font-size: 3rem;">⚡</span>
       </div>
       <h5 class="card-title fw-bold">Despesa Rápida</h5>
   <p class="card-text text-muted">
     Adicione despesas rapidamente com apenas nome e valor
    </p>
        </div>
        </div>
     </div>
       </div>
</div>

<!-- Stats Section -->
<div class="caelum-stats py-5">
    <div class="container">
        <div class="row text-center g-4">
   <div class="col-md-3">
