@page "/dashboard"
@using InovaSaude.Blazor.Services
@using InovaSaude.Blazor.Models
@using InovaSaude.Blazor.Helpers
@using System.Globalization
@inject DashboardService DashboardService
@inject ToastService ToastService
@inject NavigationManager Navigation
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Dashboard - Caelum Saúde</PageTitle>

<LoadingOverlay IsLoading="carregando" Message="Carregando dashboard..." />

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><span class="oi oi-dashboard me-2"></span>Dashboard</h2>
        <div class="d-flex align-items-center gap-2">
            <label class="form-label mb-0 fw-bold"><span class="oi oi-calendar me-1"></span>Mes:</label>
            <select class="form-select form-select-sm" style="width: auto;" @bind="mesSelecionado" @bind:after="CarregarDados">
                @for (int i = -11; i <= 0; i++)
                {
                    var mes = new DateTime(DateTimeHelper.NowBrasilia().Year, DateTimeHelper.NowBrasilia().Month, 1).AddMonths(i);
                    var valor = mes.ToString("yyyy-MM");
                    <option value="@valor">@mes.ToString("MMMM/yyyy", new CultureInfo("pt-BR"))</option>
                }
            </select>
            <span class="badge bg-secondary">@DateTimeHelper.NowBrasilia().ToString("dd/MM/yyyy HH:mm")</span>
        </div>
    </div>

    <!-- Cards de Resumo -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100 bg-danger text-white">
                <div class="card-body text-center">
                    <h1 class="display-4"><span class="oi oi-dollar"></span></h1>
                    <h3 class="mb-0">@totalDespesas.ToString("C", new CultureInfo("pt-BR"))</h3>
                    <p class="mb-0">Total Despesas</p>
                    <small>@quantidadeDespesas despesas no mes</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100 bg-warning text-dark">
                <div class="card-body text-center">
                    <h1 class="display-4"><span class="oi oi-people"></span></h1>
                    <h3 class="mb-0">@totalSalarios.ToString("C", new CultureInfo("pt-BR"))</h3>
                    <p class="mb-0">Total Salarios</p>
                    <small>@quantidadeFuncionarios funcionarios</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100 bg-primary text-white">
                <div class="card-body text-center">
                    <h1 class="display-4"><span class="oi oi-bar-chart"></span></h1>
                    <h3 class="mb-0">@((totalDespesas + totalSalarios).ToString("C", new CultureInfo("pt-BR")))</h3>
                    <p class="mb-0">Total Geral</p>
                    <small>Despesas + Salarios</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100 bg-success text-white">
                <div class="card-body text-center">
                    <h1 class="display-4"><span class="oi oi-medical-cross"></span></h1>
                    <h3 class="mb-0">@quantidadeESF</h3>
                    <p class="mb-0">ESF Cadastradas</p>
                    <small>Estrategias Saude da Familia</small>
                </div>
            </div>
        </div>
    </div>

    @if (!carregando)
    {
        <!-- Graficos e Rankings -->
        <div class="d-flex justify-content-end mb-3">
            <div class="chart-mode-selector" style="max-width: 240px;">
                <label class="form-label small fw-bold mb-1">Tipo de gráfico</label>
                <select class="form-select form-select-sm" @bind="tipoGraficoDashboard">
                    <option value="Barras">Barras (horizontal)</option>
                    <option value="Colunas">Colunas (vertical)</option>
                    <option value="Pizza">Pizza</option>
                </select>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-primary text-white">
                        <h5 class="mb-0"><span class="oi oi-bar-chart me-2"></span>Top Categorias - @mesSelecionadoDisplay</h5>
                    </div>
                    <div class="card-body">
                        @if (topCategorias.Any())
                        {
                            @if (tipoGraficoDashboard == "Barras")
                            {
                                @foreach (var cat in topCategorias)
                                {
                                    var percentual = totalDespesas > 0 ? (cat.Total / totalDespesas * 100) : 0;
                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between mb-1">
                                            <strong>@cat.Categoria</strong>
                                            <span>@cat.Total.ToString("C", new CultureInfo("pt-BR"))</span>
                                        </div>
                                        <div class="progress" style="height: 22px;">
                                            <div class="progress-bar bg-danger" style="width: @percentual.ToString("F1", CultureInfo.InvariantCulture)%" role="progressbar">
                                                @cat.Quantidade item@(cat.Quantidade != 1 ? "s" : "")
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else if (tipoGraficoDashboard == "Colunas")
                            {
                                var maxValor = topCategorias.Max(c => c.Total);
                                <div class="chart-columns-container">
                                    @for (var i = 0; i < topCategorias.Count; i++)
                                    {
                                        var cat = topCategorias[i];
                                        var altura = maxValor > 0 ? (cat.Total / maxValor * 220m) : 0;
                                        <div class="chart-column-item" title="@cat.Total.ToString("C", new CultureInfo("pt-BR"))">
                                            <div class="chart-column-bar" style="height: @altura.ToString("F0", CultureInfo.InvariantCulture)px; background-color: @GetCorGrafico(i);"></div>
                                            <small class="chart-column-label">@cat.Categoria</small>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="row align-items-center">
                                    <div class="col-md-5 text-center">
                                        <div class="chart-pie" style="@GetPieStyleCategorias()">
                                            <div class="chart-pie-inner"></div>
                                        </div>
                                    </div>
                                    <div class="col-md-7">
                                        @for (var i = 0; i < topCategorias.Count; i++)
                                        {
                                            var cat = topCategorias[i];
                                            var percentual = totalDespesas > 0 ? (cat.Total / totalDespesas * 100) : 0;
                                            <div class="d-flex justify-content-between mb-2">
                                                <span><span class="chart-legend-dot" style="background-color:@GetCorGrafico(i);"></span>@cat.Categoria</span>
                                                <strong>@percentual.ToString("F1")%</strong>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="alert alert-info mb-0">
                                <span class="oi oi-info me-2"></span>Nenhuma despesa em @mesSelecionadoDisplay
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0"><span class="oi oi-medical-cross me-2"></span>Top ESF por Despesas - @mesSelecionadoDisplay</h5>
                    </div>
                    <div class="card-body">
                        @if (esfPorDespesa.Any())
                        {
                            @if (tipoGraficoDashboard == "Barras")
                            {
                                @foreach (var esf in esfPorDespesa)
                                {
                                    var percentual = totalDespesas > 0 ? (esf.Total / totalDespesas * 100) : 0;
                                    <div class="mb-3">
                                        <div class="d-flex justify-content-between mb-1">
                                            <strong>@esf.Nome</strong>
                                            <span>@esf.Total.ToString("C", new CultureInfo("pt-BR"))</span>
                                        </div>
                                        <div class="progress" style="height: 22px;">
                                            <div class="progress-bar bg-success" style="width: @percentual.ToString("F1", CultureInfo.InvariantCulture)%" role="progressbar">
                                                @esf.Quantidade item@(esf.Quantidade != 1 ? "s" : "")
                                            </div>
                                        </div>
                                    </div>
                                }
                            }
                            else if (tipoGraficoDashboard == "Colunas")
                            {
                                var maxValor = esfPorDespesa.Max(e => e.Total);
                                <div class="chart-columns-container">
                                    @for (var i = 0; i < esfPorDespesa.Count; i++)
                                    {
                                        var esf = esfPorDespesa[i];
                                        var altura = maxValor > 0 ? (esf.Total / maxValor * 220m) : 0;
                                        <div class="chart-column-item" title="@esf.Total.ToString("C", new CultureInfo("pt-BR"))">
                                            <div class="chart-column-bar" style="height: @altura.ToString("F0", CultureInfo.InvariantCulture)px; background-color: @GetCorGrafico(i);"></div>
                                            <small class="chart-column-label">@esf.Nome</small>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <div class="row align-items-center">
                                    <div class="col-md-5 text-center">
                                        <div class="chart-pie" style="@GetPieStyleEsf()">
                                            <div class="chart-pie-inner"></div>
                                        </div>
                                    </div>
                                    <div class="col-md-7">
                                        @for (var i = 0; i < esfPorDespesa.Count; i++)
                                        {
                                            var esf = esfPorDespesa[i];
                                            var percentual = totalDespesas > 0 ? (esf.Total / totalDespesas * 100) : 0;
                                            <div class="d-flex justify-content-between mb-2">
                                                <span><span class="chart-legend-dot" style="background-color:@GetCorGrafico(i);"></span>@esf.Nome</span>
                                                <strong>@percentual.ToString("F1")%</strong>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="alert alert-info mb-0">
                                <span class="oi oi-info me-2"></span>Nenhuma despesa em @mesSelecionadoDisplay
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Acoes Rapidas -->
        <div class="row g-3">
            <div class="col-md-12">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-secondary text-white">
                        <h5 class="mb-0"><span class="oi oi-flash me-2"></span>Acoes Rapidas</h5>
                    </div>
                    <div class="card-body">
                        <div class="row g-3">
                            <div class="col-md-3">
                                <a href="/gerenciar-despesas" class="btn btn-outline-primary w-100 py-3">
                                    <h3><span class="oi oi-dollar"></span></h3>
                                    <div>Nova Despesa</div>
                                </a>
                            </div>
                            <div class="col-md-3">
                                <a href="/gerenciar-esf" class="btn btn-outline-success w-100 py-3">
                                    <h3><span class="oi oi-medical-cross"></span></h3>
                                    <div>Gerenciar ESF</div>
                                </a>
                            </div>
                            <div class="col-md-3">
                                <a href="/relatorios-financeiros" class="btn btn-outline-info w-100 py-3">
                                    <h3><span class="oi oi-bar-chart"></span></h3>
                                    <div>Relatorios</div>
                                </a>
                            </div>
                            <div class="col-md-3">
                                <a href="/gerenciar-usuarios" class="btn btn-outline-warning w-100 py-3">
                                    <h3><span class="oi oi-people"></span></h3>
                                    <div>Usuarios</div>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool carregando = true;
    private string mesSelecionado = DateTimeHelper.NowBrasilia().ToString("yyyy-MM");
    private decimal totalDespesas = 0;
    private decimal totalSalarios = 0;
    private int quantidadeDespesas = 0;
    private int quantidadeFuncionarios = 0;
    private int quantidadeESF = 0;
    private List<CategoriaData2> topCategorias = new();
    private List<ESFResumoData> esfPorDespesa = new();
    private string tipoGraficoDashboard = "Barras";

    private string mesSelecionadoDisplay =>
        DateTime.TryParseExact(mesSelecionado + "-01", "yyyy-MM-dd",
            System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out var dt)
        ? dt.ToString("MMMM/yyyy", new CultureInfo("pt-BR"))
        : mesSelecionado;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await CarregarDados();
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Erro ao carregar dashboard: " + ex.Message);
        }
        finally
        {
            carregando = false;
        }
    }

    private async Task CarregarDados()
    {
        carregando = true;
        try
        {
            // Converter mes selecionado para inicio/fim do mes
            DateTime mesRef;
            if (!DateTime.TryParseExact(mesSelecionado + "-01", "yyyy-MM-dd",
                System.Globalization.CultureInfo.InvariantCulture,
                System.Globalization.DateTimeStyles.None, out mesRef))
            {
                mesRef = new DateTime(DateTimeHelper.NowBrasilia().Year, DateTimeHelper.NowBrasilia().Month, 1);
            }
            var inicioDomes = DateTime.SpecifyKind(mesRef, DateTimeKind.Utc);
            var fimDomes = DateTime.SpecifyKind(mesRef.AddMonths(1).AddSeconds(-1), DateTimeKind.Utc);

            var resumo = await DashboardService.GetDashboardResumoMensalAsync(inicioDomes, fimDomes);

            totalDespesas = resumo.TotalDespesas;
            quantidadeDespesas = resumo.QuantidadeDespesas;
            totalSalarios = resumo.TotalSalarios;
            quantidadeFuncionarios = resumo.QuantidadeFuncionarios;
            quantidadeESF = resumo.QuantidadeESF;
            topCategorias = resumo.TopCategorias;
            esfPorDespesa = resumo.TopEsf;
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Erro ao carregar dados: " + ex.Message);
        }
        finally
        {
            carregando = false;
        }
    }

    private static readonly string[] CoresGrafico =
    {
        "#ef4444", "#3b82f6", "#10b981", "#f59e0b", "#8b5cf6", "#ec4899", "#06b6d4",
        "#e11d48", "#0ea5e9", "#14b8a6", "#f97316", "#a855f7", "#6366f1"
    };

    private string GetCorGrafico(int index) => CoresGrafico[index % CoresGrafico.Length];

    private string GetPieCategorias() => BuildPieGradient(topCategorias.Select(c => c.Total).ToList());

    private string GetPieEsf() => BuildPieGradient(esfPorDespesa.Select(e => e.Total).ToList());

    private string GetPieStyleCategorias() => "background-image: " + GetPieCategorias() + ";";

    private string GetPieStyleEsf() => "background-image: " + GetPieEsf() + ";";

    private string BuildPieGradient(List<decimal> valores)
    {
        var total = valores.Sum();
        if (total <= 0 || !valores.Any())
            return "conic-gradient(#e9ecef 0 100%)";

        var inicio = 0m;
        var segmentos = new List<string>();

        for (var i = 0; i < valores.Count; i++)
        {
            var perc = valores[i] / total * 100m;
            var fim = inicio + perc;
            var inicioTxt = inicio.ToString("F2", CultureInfo.InvariantCulture);
            var fimTxt = fim.ToString("F2", CultureInfo.InvariantCulture);
            segmentos.Add($"{GetCorGrafico(i)} {inicioTxt}% {fimTxt}%");
            inicio = fim;
        }

        var gradiente = string.Join(", ", segmentos);
        return "conic-gradient(" + gradiente + ")";
    }
}
